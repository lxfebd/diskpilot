{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskPilot",
  "version": "0.2.2",
  "identifier": "dev.diskpilot.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/prepare-sidecar.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DiskPilot",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Disk analyzer with AI advisor and per-app cleanup scaffolds",
    "longDescription": "DiskPilot scans your disk, walks you through every large folder, and lets you safely clean caches with per-app scaffolds and an AI advisor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../scaffolds": "scaffolds",
      "../../../Tools": "Tools"
    },
    "externalBin": [
      "binaries/agent-server"
    ],
    "windows": {
      "wix": {
        "language": {
          "en-US": {
            "localePath": "locale-zh-CN.wxl"
          }
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1Mjk4NkE5REQ2MjBDMDYKUldRR0RHTGRxWVlwZFd3VnlPT2tTOEl4c1NhUHArSVlJRHpmRWhqMTVTRmgyZVlPN2tPU2tsYXMK",
      "endpoints": [
        "https://github.com/lxfebd/diskpilot/releases/latest/download/latest.json"
      ]
    }
  }
}