{
  "name": "diskpilot",
  "private": true,
  "version": "0.2.2",
  "scripts": {
    "dev": "pnpm -C apps/desktop dev",
    "build": "pnpm -C apps/desktop build",
    "tauri": "pnpm -C apps/desktop tauri",
    "lint": "pnpm -C apps/desktop lint",
    "test": "cargo test --workspace",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "packageManager": "pnpm@9.12.0"
}
