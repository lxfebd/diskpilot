            "required": false,
            "desc": "导出树图 PNG"
          }
        ],
        "timeout_secs": 300
      },
      "output": {
        "format": "file",
        "parser": "smart_csv",
        "schema": "CSV 表头：Path,Size,Folder,AllocationSize,FileSize,Attributes(可按 /sortby 变)"
