        "args_template": "\"{target}\" /export=\"{outfile}\" /admin={admin}",
        "params": [
          {
            "name": "target",
            "flag": "",
            "type": "path",
            "required": true,
            "desc": "要扫描的盘或目录（如 C: 或 C:\\Users）"
          },
          {
            "name": "outfile",
            "flag": "/export",
            "type": "path",
            "required": true,
            "desc": "导出 CSV 路径（%d/%t 自动替换为日期/时间）"
          },
          {
            "name": "admin",
            "flag": "/admin",
            "type": "boolean",
            "required": false,
            "default": "1",
            "desc": "1 = 管理员模式 MFT 快速扫描"
          },
          {
            "name": "filter",
            "flag": "/filter",
            "type": "string",
            "required": false,
            "desc": "只导出匹配文件（*.mp3|*.wav）"
          },
          {
            "name": "sortby",
            "flag": "/sortby",
            "type": "enum",
            "required": false,
            "desc": "0 文件名 / 1 大小 / 2 分配 / 3 修改日期"
          },
          {
            "name": "treemap",
