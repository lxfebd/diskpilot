{
  "version": 1,
  "comment": "图吧工具箱 CLI 工具能力说明书（Tool Manifest）。每个工具 5 段：purpose/when_to_use/when_not_to_use、invocation（mode=cli|gui、launchable、args_template、params、timeout_secs）、output（format/parser/schema）、risk/permission_level/side_effects、examples。AI 路由、权限门、结构化解析都以此为准。参数表与示例出自 cli_tools_doc.md（2026-08-12）。",
  "tools": [
    {
      "name": "Prime95",
      "category": "处理器工具",
      "exe_rel": "处理器工具/Prime95/prime95.exe",
      "purpose": "CPU 稳定性/散热烤机测试（Mersenne 素数搜索程序，圈内最常用）",
      "when_to_use": "用户怀疑 CPU 不稳定/散热不足、装机验机、超频后稳定性验证",
      "when_not_to_use": "笔记本电池供电时、散热或电源余量不足时",
      "invocation": {
        "mode": "cli",
        "launchable": true,
        "args_template": "-t",
        "params": [
          {
            "name": "torture",
            "flag": "-t",
            "type": "boolean",
            "required": false,
            "desc": "启动 Torture Test 压力测试模式，直接开始烤机（阻塞式，超时自动终止）"
          }
        ],
        "timeout_secs": 1800
      },
      "output": {
        "format": "stdout",
        "parser": "stdout",
        "schema": "原始控制台输出；退出码 0 = 正常结束（超时强杀时 timed_out=true）"
      },
      "risk": "medium",
      "permission_level": "L1",
      "side_effects": "高负载烤机（阻塞式运行直到超时/手动停止），产生大量热量与功耗",
      "examples": [
        {
          "args": "-t",
          "desc": "单烤 CPU",
          "expect": "prime95 启动烤机直到超时被终止"
        }
      ],
      "publisher": "GIMPS",
      "tags": [
        "CPU",
        "烤机",
        "稳定性测试"
      ],
      "tutorial_url": "https://www.mersenne.org/download/",
      "download_hint": "https://www.mersenne.org/download/"
    },
    {
      "name": "FurMark",
      "category": "显卡工具",
      "exe_rel": "烤鸡工具/FurMark_win64/furmark.exe",
      "purpose": "GPU 烤机/基准测试（Geeks3D，命令行参数完整）",
      "when_to_use": "显卡稳定性验证、超频验证、GPU 基准跑分、显存压力测试",
      "when_not_to_use": "未指定 max-time 的无限压力测试；对显卡温度没把握时",
      "invocation": {
        "mode": "cli",
        "launchable": true,
        "args_template": "--demo {demo} {preset} --max-time {max_time}",
        "params": [
          {
            "name": "demo",
            "flag": "--demo",
            "type": "string",
            "required": false,
            "default": "furmark-gl",
            "desc": "demo 名（--demolist 查看）"
          },
          {
            "name": "preset",
            "flag": "",
            "type": "enum",
            "required": false,
            "default": "--p1080",
            "desc": "预设：--p1080/--p1440/--p2160 或 --width/--height"
          },
          {
            "name": "max_time",
            "flag": "--max-time",
            "type": "number",
            "required": false,
            "default": "600",
            "desc": "最长运行秒数（压力测试建议必填）"
          },
          {
            "name": "benchmark",
            "flag": "--benchmark",
            "type": "boolean",
            "required": false,
            "desc": "基准模式，结束时显示分数框"
          },
          {
            "name": "gpu_index",
            "flag": "--gpu-index",
            "type": "number",
            "required": false,
            "desc": "指定 GPU（0 起）"
          }
        ],
        "timeout_secs": 1800
      },
      "output": {
        "format": "stdout",
        "parser": "stdout",
        "schema": "原始控制台输出；分数写入 _scores.csv（同目录）"
      },
      "risk": "medium",
      "permission_level": "L1",
      "side_effects": "GPU 高负载（阻塞式），温度飙升；建议先用 --max-time 限时长",
      "examples": [
        {
          "args": "--demo furmark-gl --p1080 --no-score-box",
          "desc": "1080p 预设基准（结果在 _scores.csv）",
          "expect": "跑完返回退出码"
        },
        {
          "args": "--demo furmark-gl --benchmark --width 1920 --height 1080 --max-time 600",
          "desc": "1920x1080 烤机 10 分钟",
          "expect": "10 分钟后超时终止"
        },
        {
          "args": "--gpuinfo",
          "desc": "只打印 GPU 信息",
          "expect": "stdout 含 GPU 型号/显存信息"
        }
      ],
      "publisher": "Geeks3D",
      "tags": [
        "GPU",
        "烤机",
        "基准测试"
      ],
      "tutorial_url": "https://geeks3d.com/furmark/",
      "download_hint": "https://geeks3d.com/furmark/"
    },
